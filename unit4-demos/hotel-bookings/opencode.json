{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/data-contracts/fct_bookings.md"
  ],
  "mcp": {
    "bookings-warehouse": {
      "type": "local",
      "command": [
        "python",
        "mcp_server/server.py"
      ],
      "enabled": true,
      "environment": {
        "BOOKINGS_DB": "warehouse.db"
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "python tasks.py setup": "allow",
      "python tasks.py test": "allow",
      "python tasks.py occupancy": "allow",
      "python tasks.py reconcile": "allow",
      "python tasks.py acceptance": "allow",
      "python tasks.py check": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "sqlite3 *": "deny"
    }
  }
}
